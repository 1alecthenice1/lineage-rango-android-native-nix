From 225956d4cd931866c71cdd4fabaa2c18b0095ff5 Mon Sep 17 00:00:00 2001
From: 1alecthenice1 <188545014+1alecthenice1@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:31:26 +0000
Subject: [PATCH] zygote: bind the ro.nix.package app data dir on /nix in its
 own mount namespace

Native Nix store for one app chosen at build time (lineage-rango, docs/nix-design.md):
only regular user-0 app processes whose app data dir is that package, only if /nix
exists in the root image and the data dir is owned by the process uid. The bind mount
inherits nosuid/nodev from /data. Failures are logged, never fatal.

Change-Id: I2d9ffddafb0338e76e924a121a3425f31aa612e0
---
 core/jni/com_android_internal_os_Zygote.cpp | 28 +++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 15a7ee4a0..9cb9671a0 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -1909,6 +1909,31 @@ static void BindMountStorageDirs(JNIEnv* env, jobjectArray pkg_data_info_list,
   }
 }
 
+// Native /nix (lineage-rango): the one package named in ro.nix.package (set at build
+// time) gets its own data directory bind-mounted on the /nix mountpoint of the root
+// image -- in its own mount namespace only (rootfs is MS_SLAVE here, so nothing
+// propagates back). No new privileges: the store is the app's own app_data_file
+// data, used by the app as itself. Every failure is logged and skipped, never fatal.
+static void MountNixStore(uid_t uid, const std::optional<std::string>& app_data_dir) {
+  const std::string pkg = android::base::GetProperty("ro.nix.package", "");
+  if (pkg.empty() || pkg.find('/') != std::string::npos || !app_data_dir.has_value()) return;
+  const appid_t app_id = multiuser_get_app_id(uid);
+  // regular apps of user 0 only (no isolated / sdk sandbox / app zygote processes)
+  if (app_id < AID_APP_START || app_id > AID_APP_END || multiuser_get_user_id(uid) != 0) return;
+  const std::string& dir = app_data_dir.value();
+  if (dir != "/data/user/0/" + pkg && dir != "/data/data/" + pkg) return;
+  struct stat st;
+  if (TEMP_FAILURE_RETRY(stat("/nix", &st)) == -1 || !S_ISDIR(st.st_mode)) return;
+  if (TEMP_FAILURE_RETRY(stat(dir.c_str(), &st)) == -1 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != uid) {
+    ALOGW("nix: %s missing or not owned by uid %d, /nix not mounted", dir.c_str(), uid);
+    return;
+  }
+  if (TEMP_FAILURE_RETRY(mount(dir.c_str(), "/nix", nullptr, MS_BIND, nullptr)) == -1) {
+    ALOGW("nix: bind mount of %s on /nix failed: %s", dir.c_str(), strerror(errno));
+  }
+}
+
 // Utility routine to specialize a zygote child process.
 static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids, jint runtime_flags,
                              jobjectArray rlimits, jlong permitted_capabilities,
@@ -1967,6 +1992,9 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
 
         isolateJitProfile(env, pkg_data_info_list, uid, process_name, managed_nice_name, fail_fn);
     }
+    if (!is_system_server && !is_child_zygote) {
+        MountNixStore(uid, app_data_dir);
+    }
     // MOUNT_EXTERNAL_INSTALLER, MOUNT_EXTERNAL_PASS_THROUGH, MOUNT_EXTERNAL_ANDROID_WRITABLE apps
     // will have mount_storage_dirs == false here (set by ProcessList.needsStorageDataIsolation()),
     // and hence they won't bind mount storage dirs.
-- 
